!| Unit tests for FTorch's custom comparison operators.
!
!  * License
!    FTorch is released under an MIT license.
!    See the [LICENSE](https://github.com/Cambridge-ICCS/FTorch/blob/main/LICENSE)
!    file for details.
module unittest_test_utils_operators
  use funit
  use ftorch_test_utils, only: operator(.isclose.), operator(.allclose.)
  use, intrinsic :: iso_fortran_env, only: sp => real32, dp => real64

  implicit none

  public

contains

  ! Unit test for .isclose. operator with real32
  @test
  subroutine test_isclose_operator_real32()
    real(sp) :: value1, value2, value3

    value1 = 1.0_sp
    value2 = 1.000001_sp
    value3 = 2.0_sp

    ! Test that close values pass
    @assertTrue(value1 .isclose. value2)

    ! Test that distant values fail
    @assertFalse(value1 .isclose. value3)

  end subroutine test_isclose_operator_real32

  ! Unit test for .isclose. operator with real64
  @test
  subroutine test_isclose_operator_real64()
    real(dp) :: value1, value2, value3

    value1 = 1.0_dp
    value2 = 1.000001_dp
    value3 = 2.0_dp

    ! Test that close values pass
    @assertTrue(value1 .isclose. value2)

    ! Test that distant values fail
    @assertFalse(value1 .isclose. value3)

  end subroutine test_isclose_operator_real64

  ! Unit test for .allclose. operator with real32 1D arrays
  @test
  subroutine test_allclose_operator_real32_1d()
    real(sp), dimension(3) :: array1, array2, array3

    array1 = [1.0_sp, 2.0_sp, 3.0_sp]
    array2 = [1.000001_sp, 2.000001_sp, 3.000001_sp]
    array3 = [10.0_sp, 20.0_sp, 30.0_sp]

    ! Test that close arrays pass
    @assertTrue(array1 .allclose. array2)

    ! Test that distant arrays fail
    @assertFalse(array1 .allclose. array3)

  end subroutine test_allclose_operator_real32_1d

  ! Unit test for .allclose. operator with real32 2D arrays
  @test
  subroutine test_allclose_operator_real32_2d()
    real(sp), dimension(2,3) :: array1, array2, array3

    array1 = reshape([1.0_sp, 2.0_sp, 3.0_sp, 4.0_sp, 5.0_sp, 6.0_sp], [2, 3])
    array2 = reshape([1.000001_sp, 2.000001_sp, 3.000001_sp, 4.000001_sp, 5.000001_sp, 6.00001_sp], [2, 3])
    array3 = reshape([10.0_sp, 20.0_sp, 30.0_sp, 40.0_sp, 50.0_sp, 60.0_sp], [2, 3])

    ! Test that close arrays pass
    @assertTrue(array1 .allclose. array2)

    ! Test that distant arrays fail
    @assertFalse(array1 .allclose. array3)

  end subroutine test_allclose_operator_real32_2d

  ! Unit test for .allclose. operator with real32 3D arrays
  @test
  subroutine test_allclose_operator_real32_3d()
    real(sp), dimension(2,2,2) :: array1, array2, array3

    array1 = reshape([1.0_sp, 2.0_sp, 3.0_sp, 4.0_sp, 5.0_sp, 6.0_sp, 7.0_sp, 8.0_sp], [2, 2, 2])
    array2 = reshape([1.000001_sp, 2.000001_sp, 3.000001_sp, 4.000001_sp, &
                      5.000001_sp, 6.000001_sp, 7.000001_sp, 8.000001_sp], [2, 2, 2])
    array3 = reshape([10.0_sp, 20.0_sp, 30.0_sp, 40.0_sp, 50.0_sp, 60.0_sp, 70.0_sp, 80.0_sp], [2, 2, 2])

    ! Test that close arrays pass
    @assertTrue(array1 .allclose. array2)

    ! Test that distant arrays fail
    @assertFalse(array1 .allclose. array3)

  end subroutine test_allclose_operator_real32_3d

  ! Unit test for .allclose. operator with real64 1D arrays
  @test
  subroutine test_allclose_operator_real64_1d()
    real(dp), dimension(3) :: array1, array2, array3

    array1 = [1.0_dp, 2.0_dp, 3.0_dp]
    array2 = [1.000001_dp, 2.000001_dp, 3.000001_dp]
    array3 = [10.0_dp, 20.0_dp, 30.0_dp]

    ! Test that close arrays pass
    @assertTrue(array1 .allclose. array2)

    ! Test that distant arrays fail
    @assertFalse(array1 .allclose. array3)

  end subroutine test_allclose_operator_real64_1d

  ! Unit test for .allclose. operator with real64 2D arrays
  @test
  subroutine test_allclose_operator_real64_2d()
    real(dp), dimension(2,3) :: array1, array2, array3

    array1 = reshape([1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp, 5.0_dp, 6.0_dp], [2, 3])
    array2 = reshape([1.000001_dp, 2.000001_dp, 3.000001_dp, 4.000001_dp, 5.000001_dp, 6.00001_dp], [2, 3])
    array3 = reshape([10.0_dp, 20.0_dp, 30.0_dp, 40.0_dp, 50.0_dp, 60.0_dp], [2, 3])

    ! Test that close arrays pass
    @assertTrue(array1 .allclose. array2)

    ! Test that distant arrays fail
    @assertFalse(array1 .allclose. array3)

  end subroutine test_allclose_operator_real64_2d

  ! Unit test for .allclose. operator with real64 3D arrays
  @test
  subroutine test_allclose_operator_real64_3d()
    real(dp), dimension(2,2,2) :: array1, array2, array3

    array1 = reshape([1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp, 5.0_dp, 6.0_dp, 7.0_dp, 8.0_dp], [2, 2, 2])
    array2 = reshape([1.000001_dp, 2.000001_dp, 3.000001_dp, 4.000001_dp, &
                      5.000001_dp, 6.000001_dp, 7.000001_dp, 8.000001_dp], [2, 2, 2])
    array3 = reshape([10.0_dp, 20.0_dp, 30.0_dp, 40.0_dp, 50.0_dp, 60.0_dp, 70.0_dp, 80.0_dp], [2, 2, 2])

    ! Test that close arrays pass
    @assertTrue(array1 .allclose. array2)

    ! Test that distant arrays fail
    @assertFalse(array1 .allclose. array3)

  end subroutine test_allclose_operator_real64_3d

  ! Unit test for .allclose. operator with mismatched shapes
  @test
  subroutine test_allclose_operator_shape_mismatch()
    real(sp), dimension(3) :: array1
    real(sp), dimension(4) :: array2

    array1 = [1.0_sp, 2.0_sp, 3.0_sp]
    array2 = [1.0_sp, 2.0_sp, 3.0_sp, 4.0_sp]

    ! Test that arrays with mismatched shapes fail
    @assertFalse(array1 .allclose. array2)

  end subroutine test_allclose_operator_shape_mismatch

end module unittest_test_utils_operators
